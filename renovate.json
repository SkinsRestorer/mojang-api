{
  "extends": ["config:recommended", "group:allNonMajor", ":semanticCommits"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Only the publish workflow on main checks the Railpack checksums, so a passing branch build does not prove the update works. Keep it in its own pull request for manual review.",
      "matchPackageNames": ["railwayapp/railpack"],
      "groupName": null,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Railpack release installed by the publish workflow. Update its SHA-256 checksums with the version.",
      "managerFilePatterns": ["/^\\.github/workflows/publish-ghcr\\.yml$/"],
      "matchStrings": ["RAILPACK_VERSION: (?<currentValue>v\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "railwayapp/railpack"
    },
    {
      "customType": "regex",
      "description": "BuildKit image started by the publish workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/publish-ghcr\\.yml$/"],
      "matchStrings": ["moby/buildkit:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "moby/buildkit"
    }
  ]
}
